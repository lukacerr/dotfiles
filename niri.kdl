output "DP-1" { mode "1920x1080@143.981"; }
output "DP-3" { scale 1.2; }

spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/lib/policykit-1-pantheon/io.elementary.desktop.agent-polkit"
spawn-at-startup "kdeconnectd"
spawn-at-startup "blueman-manager"
spawn-at-startup "fcitx5"
spawn-at-startup "swaybg" "-o" "DP-1" "-i" "Pictures/bg.jpg"
spawn-at-startup "swaybg" "-o" "DP-3" "-i" "Pictures/bg.png"
spawn-at-startup "waybar"
spawn-at-startup "obsidian"
spawn-at-startup "vivaldi-stable"

environment {
  DISPLAY ":0"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  OZONE_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  EDITOR "zeditor"
  TERMINAL "alacritty"

  XMODIFIERS "@im=fcitx"
  QT_IM_MODULE "fcitx"

  /*
  DEFAULT_IM_MODULE "fcitx"
  QT_IM_MODULES "wayland;fcitx;ibus"
  SDL_IM_MODULE "fcitx"
  INPUT_METHOD "fcitx"
  */

  // Vivaldi fix
  DBUS_SESSION_BUS_ADDRESS "unix:path=/run/user/1000/bus"
}

binds {
	Mod+Shift+Slash { spawn "zeditor" "/home/luka/.config/niri"; }

	// SOFTWARE
	Mod+Return { spawn "alacritty"; }
	Mod+Space { spawn "fuzzel"; }
	Mod+Shift+Space { spawn "/home/luka/.config/fuzzel/fuzzel-powermenu.sh"; }
	Mod+N { spawn "swaync-client" "-t" "-sw"; }
	Mod+E { spawn "thunar"; }
	Mod+W { spawn "vivaldi-stable"; }

	// MOVEMENT AND FOCUS
	Mod+Left { focus-column-or-monitor-left; }
	Mod+Right { focus-column-or-monitor-right; }
	Mod+Down { focus-window-or-workspace-down; }
	Mod+Up { focus-window-or-workspace-up; }
	Mod+Ctrl+Left { move-column-left; }
	Mod+Ctrl+Right { move-column-right; }
	Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
	Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
	Mod+Shift+Left { focus-monitor-left; }
	Mod+Shift+Right { focus-monitor-right; }
	Mod+Shift+Down { focus-workspace-down; }
	Mod+Shift+Up { focus-workspace-up; }
	Mod+Alt+Left { move-column-to-monitor-left; }
	Mod+Alt+Right { move-column-to-monitor-right; }
	Mod+Alt+Down { move-column-to-workspace-down; }
	Mod+Alt+Up { move-column-to-workspace-up; }

	// FIXED WORKSPACE CONTROL
	Mod+1 { focus-workspace 1; }
	Mod+2 { focus-workspace 2; }
	Mod+3 { focus-workspace 3; }
	Mod+4 { focus-workspace 4; }
	Mod+5 { focus-workspace 5; }
	Mod+6 { focus-workspace 6; }
	Mod+7 { focus-workspace 7; }
	Mod+8 { focus-workspace 8; }
	Mod+9 { focus-workspace 9; }
	Mod+Ctrl+1 { move-column-to-workspace 1; }
	Mod+Ctrl+2 { move-column-to-workspace 2; }
	Mod+Ctrl+3 { move-column-to-workspace 3; }
	Mod+Ctrl+4 { move-column-to-workspace 4; }
	Mod+Ctrl+5 { move-column-to-workspace 5; }
	Mod+Ctrl+6 { move-column-to-workspace 6; }
	Mod+Ctrl+7 { move-column-to-workspace 7; }
	Mod+Ctrl+8 { move-column-to-workspace 8; }
	Mod+Ctrl+9 { move-column-to-workspace 9; }

	// MOUSE CONTROL
	Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
	Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
	Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
	Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
	Mod+WheelScrollRight { focus-column-right; }
	Mod+WheelScrollLeft { focus-column-left; }
	Mod+Ctrl+WheelScrollRight { move-column-right; }
	Mod+Ctrl+WheelScrollLeft { move-column-left; }
	Mod+Shift+WheelScrollDown { focus-column-right; }
	Mod+Shift+WheelScrollUp { focus-column-left; }
	Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
	Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }

	// CONTROL PLANE
	// ? Mod+Ctrl+Space { switch-layout "next"; }
	// ? Mod+Shift+Space { switch-layout "prev"; }
	Mod+C repeat=false { close-window; }
	Mod+O repeat=false { toggle-overview; }

	// WINDOW-SCREEN STATE
	Mod+F { maximize-column; }
	Mod+Shift+F { fullscreen-window; }
	Mod+Ctrl+F { expand-column-to-available-width; }
	Mod+Alt+F { toggle-window-floating; }
	Mod+Ctrl+Alt+F { switch-focus-between-floating-and-tiling; }

	// AUTO-RESIZING
	Mod+R { switch-preset-column-width; }
	Mod+Shift+R { switch-preset-window-height; }
	Mod+Ctrl+R { reset-window-height; }
	Mod+Ctrl+C { center-visible-columns; }

	// MANUAL RESIZING
	Mod+Minus { set-column-width "-1%"; }
	Mod+Equal { set-column-width "+1%"; }
	Mod+Alt+Minus { set-window-height "-1%"; }
	Mod+Alt+Equal { set-window-height "+1%"; }

	// SCREENSHOOTING
	Mod+S { screenshot show-pointer=false; }
	Mod+Alt+S { screenshot-window; }
	Mod+Shift+S { screenshot-screen; }

	// SPECIAL CONTROL KEYS
	Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
	Ctrl+Alt+Delete { quit skip-confirmation=true; }
	Ctrl+Shift+Delete { power-off-monitors; }
	XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
	XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
	XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
	XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
	XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
	XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
}

input {
  disable-power-key-handling
	warp-mouse-to-focus
	focus-follows-mouse
	workspace-auto-back-and-forth

	keyboard {
		repeat-delay 500
		repeat-rate 30
	}
}

layout {
  always-center-single-column
  default-column-width { proportion 0.5; }

  preset-column-widths {
    proportion 0.25
    proportion 0.5
    proportion 0.75
  }

  preset-window-heights {
    proportion 0.25
    proportion 0.5
    proportion 0.75
    proportion 1.0
  }

  shadow { on; }
  focus-ring { off; }
  insert-hint { color "#8a8a8a80"; }
  background-color "transparent"
  border {
    active-color "#c47fd5"
    inactive-color "#23232380"
    urgent-color "#e57474"
  }
}

overview {
  zoom 1
  workspace-shadow { off; }
}

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  draw-border-with-background false
  tiled-state true
}

// HIDE ON SCREENCAST
// window-rule {
// 	block-out-from "screencast"
// 	match app-id="obsidian"
// }

// DEFAULTS TO FLOATING
window-rule {
	open-floating true
  match app-id="nwg-look"
  match app-id="blueman-manager"
  match app-id="qt6ct"
  match app-id="org.fcitx.fcitx5-config-qt"
  match app-id="org.pulseaudio.pavucontrol"
  match title=r#"^Rename"#
}

// DEFAULTS TO MAXIMIZED
window-rule {
	open-maximized true
  match app-id="vivaldi-stable"
  match app-id="dev.zed.Zed"
}

// FORCE FIXED SMALL SIZE
window-rule {
	default-window-height { fixed 450; }
	default-column-width { fixed 800; }
  match app-id="blueman-manager"
  match app-id="org.pulseaudio.pavucontrol"
}

// APPLICATION SPECIFIC
window-rule {
  match app-id="obsidian"
  default-column-width { proportion 0.25; }
}

// WALLPAPER ON BACKDROP
layer-rule {
match namespace="^wallpaper$"
  place-within-backdrop true
}

animations { slowdown 0.25; }

cursor {
  xcursor-theme "Bibata-Modern-Ice"
  xcursor-size 28
  hide-after-inactive-ms 30000
}

hotkey-overlay { skip-at-startup; }
